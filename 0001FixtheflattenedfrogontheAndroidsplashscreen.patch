diff --git a/android/app/src/main/res/drawable/splash.xml b/android/app/src/main/res/drawable/splash.xml
new file mode 100644
index 0000000..f18c729
--- /dev/null
+++ b/android/app/src/main/res/drawable/splash.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  The launch theme applies this as android:background. A window background that is a
+  plain <bitmap> gets STRETCHED to the window bounds with no regard for aspect ratio,
+  which is what flattened the frog in landscape (Android resolved the portrait
+  drawable-port-* asset and squashed it across a landscape window).
+
+  A layer-list fixes that by construction: the colour layer fills the window, and the
+  bitmap layer is drawn at its intrinsic size and centred — never scaled, so it can
+  never be distorted. splash_icon.png is density-bucketed (200dp square in every
+  bucket), so it comes out the same physical size on every screen.
+-->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+  <item android:drawable="@color/splashBackground" />
+  <item>
+    <bitmap
+      android:src="@drawable/splash_icon"
+      android:gravity="center" />
+  </item>
+</layer-list>
diff --git a/android/app/src/main/res/values/colors.xml b/android/app/src/main/res/values/colors.xml
new file mode 100644
index 0000000..04247a1
--- /dev/null
+++ b/android/app/src/main/res/values/colors.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+  <!-- Swamp night — matches body background in www/index.html, the web manifest's
+       theme_color, and backgroundColor in capacitor.config.json. -->
+  <color name="splashBackground">#0d1b2a</color>
+</resources>
diff --git a/capacitor.config.json b/capacitor.config.json
index b21efba..0db009c 100644
--- a/capacitor.config.json
+++ b/capacitor.config.json
@@ -9,7 +9,7 @@
       "launchAutoHide": true,
       "backgroundColor": "#0d1b2a",
       "showSpinner": false,
-      "androidScaleType": "CENTER_CROP",
+      "androidScaleType": "CENTER",
       "splashFullScreen": true,
       "splashImmersive": true
     },
